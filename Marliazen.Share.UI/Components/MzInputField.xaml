<UserControl x:Class="Marliazen.Share.UI.Components.MzInputField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Marliazen.Share.UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LabelColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label x:Name="LabelField"
               VerticalContentAlignment="Center"
               FontSize="11"
               FontWeight="DemiBold"
               HorizontalContentAlignment="Right"/>

        <TextBox x:Name="ValueField"
                 AcceptsReturn="False"
                 VerticalContentAlignment="Center"
                 Height="Auto"
                 Grid.Column="1" />
    </Grid>
</UserControl>
